  "script": [
    "# 10초마다 용암이 3칸씩 차오른다 (최대 4단계)",
    "var level = 0",
    "var next_rise = 10",
    "",
    "on tick",
    "  if level < 4",
    "    hud(\"용암 상승까지 \" + text(max(0, next_rise - time), 0) + \"초 · 단계 \" + level + \"/4\")",
    "  else",
    "    hud(\"용암 최고 단계!\")",
    "  end",
    "end",
    "",
    "every 10",
    "  if level < 4",
    "    level = level + 1",
    "    next_rise = next_rise + 10",
    "    move_by(lava, 0, 1.5, 2)",
    "    resize(lava, lava.w, lava.h + 3, 2)",
    "    sound(\"shockwave\")",
    "    effect(\"shake\", 0, 0, 3)",
    "    banner(\"용암이 차오릅니다! \" + level + \"단계\", 1.5, \"#ff7040\")",
    "  end",
    "end",
    "",
    "on enter lava",
    "  push(player, 0, 22)",
    "  effect(\"burst\", player.x, player.y, 2, \"#ff6030\")",
    "end"
  ]
