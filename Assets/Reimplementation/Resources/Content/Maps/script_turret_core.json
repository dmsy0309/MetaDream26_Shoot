  "script": [
    "# 코어(포탑)를 5번 맞히면 폭발하고 포탑이 멈춘다",
    "var hits = 0",
    "",
    "on start",
    "  hud(\"코어를 5번 맞히면 포탑이 멈춥니다\")",
    "end",
    "",
    "on shot core",
    "  if core.visible and player != none",
    "    hits = hits + 1",
    "    effect(\"spark\", event_x, event_y, 1, \"#ffd040\")",
    "    color(core, 1, 1 - hits * 0.18, 0.2)",
    "    hud(\"코어 \" + hits + \"/5\")",
    "    if hits >= 5",
    "      explode(core.x, core.y, 5, 25, 20)",
    "      hide(core)",
    "      banner(\"포탑 파괴!\", 1.5, \"#ffd040\")",
    "      hud(\"포탑이 멈췄습니다\")",
    "    end",
    "  end",
    "end"
  ]
